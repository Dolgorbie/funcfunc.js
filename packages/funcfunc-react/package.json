{
  "name": "funcfunc-react",
  "version": "0.0.1",
  "description": "functional programing framework for React",
  "author": "Kuwabiraki Yûki",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./*": {
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "funcfunc": "^0.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint-plugin-react": "^7.37.5"
  }
}
